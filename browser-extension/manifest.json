{
  "manifest_version": 3,
  "name": "X MCP \u2014 Connect Account",
  "version": "0.3.0",
  "description": "Connect your current X session to your private X MCP server after explicit owner approval.",
  "key": "",
  "action": {
    "default_title": "Connect X to X MCP"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "host_permissions": [
    "https://mcp.example.invalid/*"
  ],
  "optional_host_permissions": [
    "https://x.com/*"
  ],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://mcp.example.invalid; base-uri 'none'"
  },
  "optional_permissions": [
    "cookies"
  ]
}
